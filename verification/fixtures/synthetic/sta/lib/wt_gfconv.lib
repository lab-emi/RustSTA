        rise_transition (lut_2x2) { values ("0.0400, 0.1000", "0.2400, 0.3000"); }
        fall_transition (lut_2x2) { values ("0.0400, 0.1000", "0.2400, 0.3000"); }
      }
      timing () {
        related_pin : "OE";
        timing_sense : negative_unate;
        timing_type : three_state_disable;
        cell_rise (lut_2x2) { values ("0.0500, 0.1300", "0.1500, 0.2300"); }
        cell_fall (lut_2x2) { values ("0.0500, 0.1300", "0.1500, 0.2300"); }
        rise_transition (lut_2x2) { values ("0.0400, 0.1000", "0.2400, 0.3000"); }
        fall_transition (lut_2x2) { values ("0.0400, 0.1000", "0.2400, 0.3000"); }
      }
    }
  }
  cell (wt_tiehi) {
    area : 0.5;
    pin (Y) { direction : output; capacitance : 0.0000; function : "1"; }
  }
  cell (wt_tielo) {
    area : 0.5;
    pin (Y) { direction : output; capacitance : 0.0000; function : "0"; }
  }
  cell (wt_fill_1) {
    area : 1.0;
    is_filler_cell : true;
    dont_use : true;
    pg_pin (VDD) { pg_type : primary_power; voltage_name : "VDD"; }
    pg_pin (VSS) { pg_type : primary_ground; voltage_name : "VSS"; }
  }
  cell (wt_aon_buf) {
    area : 2.0;
    always_on : true;
    is_isolation_cell : true;
    pg_pin (VDD) { pg_type : primary_power; voltage_name : "VDD"; }
    pg_pin (VSS) { pg_type : primary_ground; voltage_name : "VSS"; }
    leakage_power () { when : "!A"; value : 0.25; }
    pin (A) { direction : input; capacitance : 0.0100; }
    pin (Y) {
      direction : output;
      function : "A";
      internal_power () {
        related_pin : "A";
        rise_power (pwr_2x2) { values ("0.01, 0.02", "0.03, 0.04"); }
        fall_power (pwr_2x2) { values ("0.01, 0.02", "0.03, 0.04"); }
      }
    }
  }
}
